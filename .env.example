# Copie para .env e preencha (NÃO commitar o .env)

NOTION_TOKEN=ntn_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NOTION_DATABASE_IDS=id_da_database_1,id_da_database_2
DISCORD_WEBHOOK_PRECOS=https://discord.com/api/webhooks/.../...
DISCORD_WEBHOOK_ESGOTADOS=https://discord.com/api/webhooks/.../...
PRICE_THRESHOLD=10

# Opcionais — timeouts do scraper (ms), padrão 20000/22000/15000:
# READY_TIMEOUT_MS=20000
# PRICE_DEADLINE_MS=22000
# USD_EXTRA_MS=15000

# Opcional — abas simultâneas por fornecedor no scrape (padrão 3; 1 = sequencial;
# a AtacadoCollections roda sempre com 1 aba, independente deste valor):
# SCRAPE_CONCURRENCY=3

# Opcional — espera antes da 2ª tentativa de quem falhou (padrão 90000 = 90s):
# RETRY_COOLDOWN_MS=90000
